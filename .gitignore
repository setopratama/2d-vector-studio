data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3
*.db
*.db-shm
*.db-wal

# Generated output images directory (Microstock vector PNGs)
data/outputs/
outputs/
!data/.gitkeep
!data/outputs/.gitkeep

