# ==============================================================================
# ENVIRONMENT VARIABLES & API KEYS (CRITICAL SECURITY)
# ==============================================================================
# Jangan pernah meng-commit file .env yang berisi API key asli
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!*.env.example

# Private keys & certificates
*.pem
*.key
*.cert

# ==============================================================================
# LOCAL DATABASE & GENERATED MEDIA (DATA SAFETY & STORAGE)
# ==============================================================================
