# ==============================================================================
# ENVIRONMENT VARIABLES & API KEYS (CRITICAL SECURITY)
# ==============================================================================
# Jangan pernah meng-commit file .env yang berisi API key asli
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
*.env.local
!.env.example
!*.env.example

# Private keys & certificates
*.pem
*.key
*.cert
*.crt

# ==============================================================================
# LOCAL DATABASE & GENERATED MEDIA (DATA SAFETY & STORAGE)
# ==============================================================================
# SQLite database files & WAL journals
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3
data/*.sqlite-shm
data/*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated output images directory (Microstock vector PNGs)
data/outputs/*
!data/outputs/.gitkeep
!data/.gitkeep
outputs/

