# ==============================================================================
# OPENROUTER & CUSTOM AI API CONFIGURATION
# ==============================================================================
# API Key OpenRouter atau Custom OpenAI-Compatible Provider
# Dapatkan API key resmi di https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# CUSTOM ENDPOINTS / BASE URL CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL API (Default: https://openrouter.ai/api/v1)
# Dapat diganti ke Custom Proxy, LiteLLM, OneAPI, LM Studio, Ollama, atau LocalAI
# Contoh Local LLM: http://localhost:11434/v1 atau http://localhost:1234/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Custom Endpoint Khusus untuk Chat / Prompt Expansion (Opsional)
# Jika dikosongkan, akan menggunakan ${OPENROUTER_BASE_URL}/chat/completions
OPENROUTER_PROMPT_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# Custom Endpoint Khusus untuk Image Generation (Opsional)
# Jika dikosongkan, akan menggunakan ${OPENROUTER_BASE_URL}/images atau /images/generations
OPENROUTER_IMAGE_ENDPOINT=https://openrouter.ai/api/v1/images

# ------------------------------------------------------------------------------
# MODEL SELECTION
# ------------------------------------------------------------------------------
# Model untuk Prompt Expansion / Engineering (Chat Completion)
# Default: deepseek/deepseek-v4-flash-0731
# Alternatif: openai/gpt-4o-mini, qwen/qwen-2.5-72b-instruct, anthropic/claude-3.5-haiku
OPENROUTER_PROMPT_MODEL=deepseek/deepseek-v4-flash-0731

# Model untuk Image Generation (Text-to-Image)
# Default: openai/gpt-image-2.5-sunburst
# Alternatif: black-forest-labs/flux-1-schnell, stabilityai/stable-diffusion-xl-base-1.0
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2.5-sunburst

# ------------------------------------------------------------------------------
# OPENROUTER HEADERS (OPSIONAL)
# ------------------------------------------------------------------------------
# Header untuk identifikasi aplikasi di peringkat OpenRouter
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_SITE_NAME=2D Vector Studio

# ==============================================================================
# EXCHANGE RATE API (API.CO.ID) - KURS REAL-TIME USD -> IDR
# ==============================================================================
# Dokumentasi: https://docs.api.co.id/products/exchange-rate#/Exchange%20Rates/get_api_exchange_rates
# Sistem Caching: Hit 1x saat buka web per hari. Jika ganti hari (00:00), hit ulang 1x.
EXCHANGE_RATE_API_URL=https://use.api.co.id/api/exchange-rates

# API Key / Token API.co.id (Opsional jika endpoint membutuhkan autentikasi header)
# Contoh: x-api-key atau Bearer token
EXCHANGE_RATE_API_KEY=

# Aktifkan fetch kurs dinamis (true = aktifkan hit 1x harian, false = gunakan kurs statis)
ENABLE_DYNAMIC_EXCHANGE_RATE=true

# Kurs Default / Fallback jika offline atau limit tercapai (USD ke IDR)
USD_TO_IDR_RATE=16000

# ==============================================================================
# HARGA & ESTIMASI BIAYA (CUSTOM PRICING)
# ==============================================================================
# Tarif token DeepSeek v4 Flash (atau model kustom Anda)
PROMPT_INPUT_PER_TOKEN_USD=0.00000014
PROMPT_OUTPUT_PER_TOKEN_USD=0.00000056

# Tarif per gambar 1:1 (GPT Image 2.5 Sunburst)
IMAGE_FLAT_COST_PER_UNIT_USD=0.020000

# ==============================================================================
# SERVER & APP CONFIGURATION
# ==============================================================================
PORT=3001
NODE_ENV=development
